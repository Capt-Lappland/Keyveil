<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>panel.shortcut_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shortcuts@</string>
        <key>shortcuts</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>%lld 个快捷键</string>
        </dict>
    </dict>
    <key>panel.group.show_more</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@more@</string>
        <key>more</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>还有 %lld 项</string>
        </dict>
    </dict>
    <key>panel.group.folded_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@folded@</string>
        <key>folded</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>展开全部 %lld 项</string>
        </dict>
    </dict>
</dict>
</plist>
